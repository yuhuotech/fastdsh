{
  "name": "fastdsh",
  "productName": "FastDSH",
  "version": "0.1.0",
  "private": true,
  "description": "One-click desktop client for DeepSeek Harness (@deepseek-ai/dsh)",
  "author": "yuhuotech",
  "license": "MIT",
  "homepage": "https://github.com/yuhuotech/fastdsh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuhuotech/fastdsh.git"
  },
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && electron .",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:mac:x64": "bash scripts/install-arch-deps.sh darwin x64 && npm run build && electron-builder --mac --x64",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0"
  }
}
